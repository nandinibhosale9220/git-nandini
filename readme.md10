    2. Backend – app.py
Purpose: Accepts user input, predicts High or Low, and stores the result in MySQL.

File:  notepadapp.py

##########################################

from flask import Flask, request, jsonify
import mysql.connector
import time

app = Flask(__name__)

db_config = {
    "host": "db",
    "user": "aiuser",
    "password": "aipassword",
    "database": "aidb"
}

def initialize_database():
    for attempt in range(15):
        try:
            conn = mysql.connector.connect(**db_config)
            cursor = conn.cursor()

            cursor.execute("""
                CREATE TABLE IF NOT EXISTS predictions (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    input_value FLOAT,
                    prediction VARCHAR(20)
                )
            """)

            conn.commit()
            cursor.close()
            conn.close()

            print("Database connected successfully!")
            return

        except mysql.connector.Error as e:
            print("Waiting for database:", e)
            time.sleep(3)

    raise Exception("Database connection failed")

@app.route("/")
def home():
    return """
    <h1>AI Model Deployment Using Docker Compose</h1>
    <p>Application is running successfully!</p>
    """

@app.route("/predict", methods=["GET", "POST"])
def predict():

    if request.method == "POST":
        data = request.get_json(silent=True) or {}
        value = data.get("value")
    else:
        value = request.args.get("value", default=0)

    try:
        value = float(value)
    except (ValueError, TypeError):
        return jsonify({"error": "Enter a valid number"}), 400

    if value >= 50:
        result = "High"
    else:
        result = "Low"

    try:
        conn = mysql.connector.connect(**db_config)
        cursor = conn.cursor()

        cursor.execute(
            "INSERT INTO predictions (input_value, prediction) VALUES (%s, %s)",
            (value, result)
        )

        conn.commit()
        cursor.close()
        conn.close()

    except mysql.connector.Error as e:
        return jsonify({"error": str(e)}), 500

    return jsonify({
        "input": value,
        "prediction": result,
        "message": "Prediction saved successfully"
    })

if __name__ == "__main__":
    initialize_database()
    app.run(host="0.0.0.0", port=5000)
    
